{
  "name": "proofroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run compile && npm run frontend:build",
    "compile": "hardhat build",
    "test": "hardhat test mocha",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.js --build-profile production --network localhost",
    "demo:local": "hardhat run scripts/verify-local-flow.js --network localhost",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:test": "npm run test --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:lint": "npm run lint --workspace frontend",
    "frontend:preview": "npm run preview --workspace frontend -- --host 127.0.0.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "ethers": "6.17.0",
    "hardhat": "3.14.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
